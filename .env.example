# MODE TERKELOLA (dibagikan ke pengguna) — diisi ADMIN sekali, lalu commit.
# Aman dipublikasikan: anon key hanya bisa memanggil fungsi register_user (tabel dikunci RLS).
# JANGAN pernah menaruh service_role key atau DEEPSEEK_API_KEY admin di file ini.
# Kosongkan SUPABASE_URL untuk memakai mode lama (key DeepSeek/Ollama sendiri di .env).
# Admin yang mau pakai mode lama saat pengembangan: tambahkan USER_AUTH=off di .env.
# =====================================================================
SUPABASE_URL=https://whghcdlsfldjiwjnxerq.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndoZ2hjZGxzZmxkaml3am54ZXJxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5ODk0ODAsImV4cCI6MjEwOTU2NTQ4MH0.cmuwn1ZnBeQZZV5wG_Ck-ttptxrAmMAK7zpfwoABzos
# Diisi otomatis oleh /signup ke file .env (bukan di sini):
# USER_API_KEY=

# LitReview Studio — pilih provider AI
# LLM_PROVIDER=ollama  -> model lokal (gratis, tanpa internet)
# LLM_PROVIDER=deepseek -> DeepSeek API (berbayar per token)
LLM_PROVIDER=deepseek

# ---- Ollama lokal ----
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_NUM_CTX=12288
OLLAMA_MAX_OUTPUT_TOKENS=3500

# ---- DeepSeek API (dipakai bila LLM_PROVIDER=deepseek) ----
# API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Tarif OFF-PEAK, USD per 1 juta token (default = deepseek-flash). Saat jam peak dikali PEAK_MULTIPLIER.
# Peak = Senin-Jumat 01:00-04:00 & 06:00-10:00 UTC (= 08:00-11:00 & 13:00-17:00 WIB). Selain itu off-peak.
# Cek tarif terbaru: https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_PRICE_INPUT_MISS=0.15
DEEPSEEK_PRICE_INPUT_HIT=0.003
DEEPSEEK_PRICE_OUTPUT=0.60
DEEPSEEK_PEAK_MULTIPLIER=2
USD_TO_IDR=18000

# ---- Batas pemakaian (opsional) ----
# Bila dikosongkan, nilai bawaan mengikuti provider:
#   Ollama lokal : teks 18000 karakter/PDF, 8 PDF/upload, 12 MB/PDF, sintesis 4 artikel/batch
#   DeepSeek API : teks 80000 karakter/PDF, 20 PDF/upload, 30 MB/PDF, sintesis 12 artikel/batch
# CATATAN: nilai yang kamu tulis di sini SELALU menang. Kalau .env lamamu masih berisi
# MAX_TEXT_CHARS=18000, hapus atau ganti barisnya agar bawaan DeepSeek (80000) berlaku.
# Batas pengaman keras MAX_TEXT_CHARS adalah 200000.
MAX_TEXT_CHARS=130000
MAX_FILES_PER_BATCH=20
MAX_FILE_MB=30
SYNTH_BATCH_SIZE=12
REDUCE_GROUP_SIZE=8
# Pengali plafon token output (hanya batas atas, tidak menambah biaya bila jawaban lebih pendek)
LLM_OUTPUT_SCALE=1.75

# ---- Salinan di server (opsional) ----
# Hasil kerja utama ada di proyek browser + file Ekspor. Salinan di folder data/ hanya arsip
# dan TIDAK dibaca lagi oleh aplikasi. Isi false untuk berhenti menulisnya.
KEEP_SERVER_PDFS=true
KEEP_SERVER_JSON=true

# ---- Umum ----
APP_USERNAME=slr-user
APP_PASSWORD=
PORT=5000
# Hanya bisa dibuka dari komputer ini (aman untuk laptop pengguna). Hapus baris ini hanya jika ingin diakses dari jaringan.
HOST=127.0.0.1
